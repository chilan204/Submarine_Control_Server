DB_URL=jdbc:mysql://127.0.0.1:3306/submarine_control
DB_USERNAME=submarine
DB_PASSWORD=change-me
DDL_AUTO=update

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXP=3600000
JWT_REFRESH_EXP=604800000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PHONE=000000000

# Must match Submarine_Control_AI/.env when the services are not loopback-only.
AI_INTERNAL_TOKEN=replace-with-a-random-service-token
AI_URL=http://127.0.0.1:5000
AI_TIMEOUT=120

AUV_HOST=100.112.130.80
AUV_PORT=5600

# AUV telemetry producers connect to /ws?ingest_token=<this value>.
TELEMETRY_INGEST_TOKEN=replace-with-a-random-ingest-token
